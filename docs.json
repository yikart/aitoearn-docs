{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "luma",
  "name": "AiToEarn Open Platform",
  "description": "AiToEarn 开放平台文档",
  "colors": {
    "primary": "#A989FF",
    "light": "#B8A1FF",
    "dark": "#8B63F7"
  },
  "favicon": "/favicon.svg",
  "logo": {
    "light": "/assets/logo/logo-light.png",
    "dark": "/assets/logo/logo-dark.png",
    "href": "/zh/home"
  },
  "appearance": {
    "default": "system",
    "strict": false
  },
  "icons": {
    "library": "lucide"
  },
  "api": {
    "playground": {
      "display": "interactive"
    },
    "params": {
      "expanded": "all"
    },
    "url": "full",
    "examples": {
      "languages": [
        "curl",
        "python",
        "javascript",
        "go"
      ],
      "defaults": "required",
      "prefill": true,
      "autogenerate": true
    }
  },
  "navigation": {
    "languages": [
      {
        "language": "zh",
        "default": true,
        "navbar": {
          "links": [
            {
              "type": "github",
              "href": "https://github.com/yikart/AiToEarn",
              "label": "GitHub"
            }
          ],
          "primary": {
            "type": "button",
            "label": "前往 AiToEarn",
            "href": "https://aitoearn.cn/"
          }
        },
        "tabs": [
          {
            "tab": "首页",
            "hidden": true,
            "groups": [
              {
                "group": "首页",
                "hidden": true,
                "pages": [
                  "zh/home"
                ]
              }
            ]
          },
          {
            "tab": "使用",
            "icon": "book-open",
            "groups": [
