{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "luma",
  "name": "AiToEarn Open Platform",
  "description": "AiToEarn 开放平台文档",
  "colors": {
    "primary": "#A989FF",
    "light": "#B8A1FF",
    "dark": "#8B63F7"
  },
  "favicon": "/favicon.svg",
  "logo": {
    "light": "/assets/logo/logo-light.png",
    "dark": "/assets/logo/logo-dark.png",
    "href": "/zh/home"
  },
  "appearance": {
    "default": "system",
    "strict": false
  },
  "icons": {
    "library": "lucide"
  },
  "navigation": {
    "languages": [
      {
        "language": "zh",
        "default": true,
        "navbar": {
          "links": [
            {
              "type": "github",
              "href": "https://github.com/yikart/AiToEarn",
              "label": "GitHub"
            }
          ],
          "primary": {
            "type": "button",
            "label": "前往 AiToEarn",
            "href": "https://aitoearn.cn/"
          }
        },
        "tabs": [
          {
            "tab": "首页",
            "hidden": true,
            "groups": [
              {
                "group": "首页",
                "hidden": true,
                "pages": [
                  "zh/home"
                ]
              }
            ]
          },
          {
            "tab": "使用",
            "icon": "book-open",
            "groups": [
              {
                "group": "使用",
                "pages": [
                  "zh/use/index"
                ]
              }
            ]
          },
          {
            "tab": "API 文档",
            "icon": "code",
            "groups": [
              {
                "group": "API 文档",
                "pages": [
                  "zh/api/index"
                ]
              }
            ]
          }
        ]
      },
      {
        "language": "en",
        "navbar": {
          "links": [
            {
              "type": "github",
              "href": "https://github.com/yikart/AiToEarn",
              "label": "GitHub"
            }
          ],
          "primary": {
            "type": "button",
            "label": "Go to AiToEarn",
            "href": "https://aitoearn.ai/"
          }
        },
        "tabs": [
          {
            "tab": "Home",
            "hidden": true,
            "groups": [
              {
                "group": "Home",
                "hidden": true,
                "pages": [
                  "en/home"
                ]
              }
            ]
          },
          {
            "tab": "Use",
            "icon": "book-open",
            "groups": [
              {
                "group": "Use",
                "pages": [
                  "en/use/index"
                ]
              }
            ]
          },
          {
            "tab": "API Docs",
            "icon": "code",
            "groups": [
              {
                "group": "API Docs",
                "pages": [
                  "en/api/index"
                ]
              }
            ]
          }
        ]
      }
    ]
  },
  "contextual": {
    "options": [
      "copy",
      "view"
    ]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/yikart/AiToEarn"
    }
  }
}
